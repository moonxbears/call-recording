{
  "name": "Call",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Display label for the call, typically contact name or number"
    },
    "phone_number": {
      "type": "string",
      "description": "E.164 formatted phone number"
    },
    "contact_name": {
      "type": "string",
      "description": "Resolved contact name if known"
    },
    "direction": {
      "type": "string",
      "enum": [
        "incoming",
        "outgoing"
      ],
      "default": "incoming"
    },
    "duration_sec": {
      "type": "number",
      "description": "Total call duration in seconds"
    },
    "status": {
      "type": "string",
      "enum": [
        "processing",
        "ready",
        "failed"
      ],
      "default": "ready"
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "starred": {
      "type": "boolean",
      "default": false
    },
    "sentiment": {
      "type": "string",
      "enum": [
        "positive",
        "neutral",
        "negative"
      ],
      "default": "neutral"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "speakers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Speaker labels resolved by diarization",
      "default": []
    },
    "transcript": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "speaker": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "start": {
            "type": "number"
          },
          "end": {
            "type": "number"
          }
        }
      },
      "default": []
    },
    "waveform": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Normalized amplitude samples 0-1 for visualizer",
      "default": []
    },
    "recording_url": {
      "type": "string",
      "description": "Optional public URL to the audio file"
    },
    "intercepted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the call was captured"
    },
    "drive_synced": {
      "type": "boolean",
      "default": false,
      "description": "Whether the transcript and audio have been backed up to Google Drive"
    }
  },
  "required": [
    "title",
    "duration_sec"
  ]
}