{
  "name": "Setting",
  "type": "object",
  "properties": {
    "auto_record_incoming": {
      "type": "boolean",
      "default": true,
      "description": "Automatically capture incoming calls"
    },
    "auto_record_outgoing": {
      "type": "boolean",
      "default": true,
      "description": "Automatically capture outgoing calls"
    },
    "record_when_roaming": {
      "type": "boolean",
      "default": false,
      "description": "Continue recording while roaming on foreign networks"
    },
    "min_duration_sec": {
      "type": "number",
      "default": 3,
      "description": "Discard calls shorter than this many seconds"
    },
    "retention_days": {
      "type": "number",
      "enum": [
        7,
        30,
        90,
        365,
        3650
      ],
      "default": 90,
      "description": "How long to keep recordings before auto-deletion"
    },
    "encrypt_recordings": {
      "type": "boolean",
      "default": true,
      "description": "Encrypt stored audio at rest"
    },
    "auto_transcribe": {
      "type": "boolean",
      "default": true,
      "description": "Generate a transcript automatically after each call"
    },
    "transcription_language": {
      "type": "string",
      "default": "en-US",
      "description": "BCP-47 language tag for transcription"
    },
    "speaker_diarization": {
      "type": "boolean",
      "default": true,
      "description": "Separate and label individual speakers"
    },
    "profanity_filter": {
      "type": "boolean",
      "default": false,
      "description": "Mask profanity in transcript text"
    },
    "transcription_model": {
      "type": "string",
      "enum": [
        "fast",
        "balanced",
        "accurate"
      ],
      "default": "balanced",
      "description": "Accuracy vs speed tradeoff for the transcription engine"
    },
    "audio_format": {
      "type": "string",
      "enum": [
        "mp3",
        "wav",
        "aac",
        "opus"
      ],
      "default": "mp3",
      "description": "Container/codec for exported audio"
    },
    "audio_quality": {
      "type": "string",
      "enum": [
        "standard",
        "high",
        "lossless"
      ],
      "default": "high",
      "description": "Bitrate / fidelity of exported audio"
    },
    "transcript_format": {
      "type": "string",
      "enum": [
        "txt",
        "srt",
        "vtt",
        "json"
      ],
      "default": "txt",
      "description": "Default export format for transcripts"
    },
    "include_timestamps": {
      "type": "boolean",
      "default": true,
      "description": "Embed timecodes in exported transcripts"
    },
    "auto_export_cloud": {
      "type": "boolean",
      "default": false,
      "description": "Mirror exports to connected cloud storage"
    },
    "notify_new_recording": {
      "type": "boolean",
      "default": true,
      "description": "Alert when a new recording is captured"
    },
    "notify_transcription_ready": {
      "type": "boolean",
      "default": true,
      "description": "Alert when a transcript finishes processing"
    },
    "email_summary": {
      "type": "string",
      "enum": [
        "never",
        "daily",
        "weekly"
      ],
      "default": "weekly",
      "description": "Cadence for the recording activity digest email"
    }
  },
  "required": []
}